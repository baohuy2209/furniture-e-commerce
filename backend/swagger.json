{
  "openapi": "3.0.0",
  "info": {
    "title": "Moji",
    "version": "1.0.0",
    "description": ""
  },
  "servers": [
    {
      "url": "http://localhost:5001/api"
    }
  ],
  "paths": {
    "/auth/signup": {
      "post": {
        "summary": "SignUp",
        "tags": ["Authentication"],
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "format": "color"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "firstName": {
                    "type": "string"
                  },
                  "lastName": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/signin": {
      "post": {
        "summary": "SignIn",
        "description": "Log in với username và password. Trả về access token trong res và refresh token trong cookie.",
        "tags": ["Authentication"],
        "responses": {
          "200": {
            "description": "User successfully signed in",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "User Hai User đã logged in!"
                    },
                    "accessToken": {
                      "type": "string",
                      "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                    }
                  },
                  "required": ["message", "accessToken"]
                }
              }
            }
          },
          "400": { "description": "Invalid input" },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Internal server error" }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "format": "color"
                  }
                },
                "required": ["username", "password"]
              }
            }
          }
        }
      }
    },
    "/auth/signout": {
      "post": {
        "summary": "SignOut",
        "tags": ["Authentication"],
        "responses": {
          "200": { "description": "Success" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "RefreshToken",
        "tags": ["Authentication"],
        "responses": {}
      }
    },
    "/users/me": {
      "get": {
        "summary": "AuthMe",
        "tags": ["Authentication"],
        "responses": {}
      }
    },
    "/friends/requests": {
      "post": {
        "summary": "SendFriendRequest",
        "tags": ["Friends"],
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "GetFriendRequests",
        "tags": ["Friends"],
        "responses": {}
      }
    },
    "/friends/requests/68faed19defb37e90657d7d6/accept": {
      "post": {
        "summary": "AcceptFriendRequest",
        "tags": ["Friends"],
        "responses": {}
      }
    },
    "/friends/requests/68fb124874f8418a6bc83ed1/decline": {
      "post": {
        "summary": "DeclineFriendRequest",
        "tags": ["Friends"],
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/friends/": {
      "get": {
        "summary": "GetAllFriends",
        "tags": ["Friends"],
        "responses": {}
      }
    },
    "/messages/direct": {
      "post": {
        "summary": "SendDirectMessage",
        "tags": ["Messages"],
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "recipientId": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/conversations/": {
      "post": {
        "summary": "CreateConversation",
        "tags": ["Conversations"],
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "memberIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "GetConversations",
        "tags": ["Conversations"],
        "responses": {}
      }
    },
    "/conversations/68fb2e6a19c501587577291c/messages": {
      "get": {
        "summary": "GetMessage",
        "tags": ["Conversations"],
        "responses": {}
      }
    },
    "/admin/vouchers": {
      "get": {
        "tags": ["Admin Voucher"],
        "summary": "Lấy danh sách voucher (Admin)",
        "parameters": [
          { "name": "page", "in": "query", "type": "integer" },
          { "name": "size", "in": "query", "type": "integer" },
          { "name": "q", "in": "query", "type": "string", "description": "Tìm theo mã hoặc tên" },
          { "name": "status", "in": "query", "type": "string", "enum": ["active", "paused", "expired", "pending"] },
          { "name": "type", "in": "query", "type": "string", "enum": ["percent", "fixed", "freeship"] }
        ],
        "responses": {
          "200": { "description": "Thành công" }
        }
      },
      "post": {
        "tags": ["Admin Voucher"],
        "summary": "Tạo voucher mới (Admin)",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "type": "object",
              "required": ["code", "voucher_name", "value", "start_date", "end_date"],
              "properties": {
                "code": { "type": "string" },
                "voucher_name": { "type": "string" },
                "type": { "type": "string", "enum": ["percent", "fixed", "freeship"] },
                "value": { "type": "number" },
                "min_order_value": { "type": "number" },
                "usage_limit": { "type": "number" },
                "start_date": { "type": "string", "format": "date-time" },
                "end_date": { "type": "string", "format": "date-time" },
                "description": { "type": "string" },
                "appliedTo": { "type": "string", "enum": ["all", "specific"] },
                "applied_products": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        ],
        "responses": {
          "201": { "description": "Tạo thành công" }
        }
      }
    },
    "/admin/vouchers/{id}": {
      "get": {
        "tags": ["Admin Voucher"],
        "summary": "Chi tiết voucher",
        "parameters": [{ "name": "id", "in": "path", "required": true, "type": "string" }],
        "responses": { "200": { "description": "Thành công" } }
      },
      "put": {
        "tags": ["Admin Voucher"],
        "summary": "Cập nhật voucher",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          { "name": "body", "in": "body", "schema": { "type": "object" } }
        ],
        "responses": { "200": { "description": "Cập nhật thành công" } }
      },
      "delete": {
        "tags": ["Admin Voucher"],
        "summary": "Xóa voucher",
        "parameters": [{ "name": "id", "in": "path", "required": true, "type": "string" }],
        "responses": { "200": { "description": "Xóa thành công" } }
      }
    },
    "/admin/vouchers/{id}/toggle": {
      "patch": {
        "tags": ["Admin Voucher"],
        "summary": "Bật/Tắt voucher",
        "parameters": [{ "name": "id", "in": "path", "required": true, "type": "string" }],
        "responses": { "200": { "description": "Thành công" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
